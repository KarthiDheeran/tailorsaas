# Copy to .env.local (gitignored) and fill in real values from your Supabase
# project's Settings -> API page. See supabase/README.md for setup steps.

# Public — safe to expose to the browser. Requests made with the anon key are
# still subject to the RLS policies in supabase/migrations/0001_auth_foundation.sql.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only — NEVER import this into a "use client" file or send it to the
# browser. Bypasses RLS entirely; used only by server-side Admin API calls
# (creating users, resetting passwords) starting in Phase 4.
SUPABASE_SERVICE_ROLE_KEY=

{
  "name": "tailorsaas",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "test": "npm run test:garment-runtime && npm run test:requests && npm run test:orders",
    "test:orders": "node --test tests/order-deletion.test.mjs",
    "test:database-workflows": "node --test tests/database-workflows.test.mjs",
    "test:business-rules": "node --test tests/business-rules.test.mjs",
    "test:report-audit": "node --test tests/report-audit.test.mjs",
    "test:full": "node scripts/run-full-review.mjs",
    "test:requests": "tsc -p tsconfig.request-tests.json && node --test .request-test-dist/tests/request-activity.test.js",
    "test:e2e": "playwright test",
    "test:garment-runtime": "tsc -p tsconfig.garment-runtime-tests.json && node --test .runtime-test-dist/tests/garment-form-runtime.test.js",
    "audit:garment-metadata": "node --env-file=.env.local scripts/audit-garment-metadata.mjs"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.0",
    "@supabase/supabase-js": "^2.110.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.23.0",
    "next": "14.2.35",
    "react": "^18",
    "react-dom": "^18",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@playwright/test": "^1.63.0",
    "@types/node": "^22",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "eslint": "^8",
    "eslint-config-next": "14.2.35",
    "postcss": "^8",
    "tailwindcss": "^3.4.1",
    "typescript": "^5"
  }
}
